# Copie para .env na raiz do repositorio e defina senhas locais fortes.
# NUNCA suba o arquivo .env para o GitHub.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=resgate_animais
MYSQL_USER=resgate_app
MYSQL_PASSWORD=

# Portas acessiveis somente no proprio computador.
MYSQL_HOST_PORT=3307
WEB_PORT=3000
# Para demonstracao na rede local, WEB_BIND_HOST=0.0.0.0. Nunca expose diretamente na internet.
WEB_BIND_HOST=127.0.0.1

# Recuperação de senha por e-mail (opcional; exige chave do provedor e domínio remetente verificado)
RESEND_API_KEY=
MAIL_FROM=
APP_PUBLIC_URL=http://localhost:3000
